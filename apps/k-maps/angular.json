{
  "$schema": "../../node_modules/@angular/cli/lib/config/schema.json",
  "cli": { "analytics": false },
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "k-maps": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": { "style": "scss" },
        "@schematics/angular:application": { "strict": true }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "km",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/k-maps",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "preserveSymlinks": true,
            "assets": [
              "src/favicon.ico",
              "src/assets",
              {
                "glob": "**/*",
                "input": "node_modules/monaco-editor/min/vs",
                "output": "assets/monaco/vs"
              }
            ],
            "styles": ["src/scss/styles.scss"],
            "scripts": []
          },
          "configurations": {
            "production": {
              "optimization": { "fonts": false },
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "budgets": [
                { "type": "initial", "maximumWarning": "5mb", "maximumError": "8mb" },
                { "type": "anyComponentStyle", "maximumWarning": "40kb", "maximumError": "64kb" }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": { "proxyConfig": "proxy.conf.json" },
          "configurations": {
            "production": { "buildTarget": "k-maps:build:production" },
            "development": { "buildTarget": "k-maps:build:development" },
            "local-worker": {
              "buildTarget": "k-maps:build:development",
              "proxyConfig": "proxy.conf.local.json"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
