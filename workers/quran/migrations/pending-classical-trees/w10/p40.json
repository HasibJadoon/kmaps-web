null, "depth": 1, "node_order": 7, "created_at": "2026-08-28 18:22:35", "term_key": "masdar_muawwal", "label_ar": "اللام للتعليل ويأخذوه مضارع منصوب بأن مضمرة بعدها والواو فاعل، والمصدر المؤول في محل جر باللام متعلق بهمت (الميسر ودعاس نصا). والأخذ يستعمل مجازا بمعنى التصرف بالعقاب والتعذيب والقتل، واختير هنا ليشمل مختلف ما همت به كل أمة (ابن عاشور نصا)؛ وهو كناية عن التمكن (الآلوسي)، وقال قتادة: أي ليقتلوه", "note_md": null, "word_occurrence_id": "a50beb731dd411c54698e912f3", "is_virtual": 0, "tafsir_note_md": null, "tafsir_refs": null, "balagha_note_md": null, "balagha_refs": null, "gloss_json": null, "sarf_note_md": null, "sarf_refs": null, "sarf_term_ref": null, "gram_term_ref": "GT:irab_role:masdar_muawwal"}, {"id": "QR:SSN:40:5:s2:$.tree.children[4].children[0]", "tree_id": "QR:TR:40:5:s2", "parent_node_id": "QR:SSN:40:5:s2:$.tree.children[4]", "node_label": "هُ", "scope_type": null, "scope_id": null, "depth": 2, "node_order": 8, "created_at": "2026-08-28 18:22:35", "term_key": "maful_bih", "label_ar": "الهاء مفعول به عائد على الرسول (الميسر والدرويش نصا)", "note_md": null, "word_occurrence_id": "a50beb731dd411c54698e912f3", "is_virtual": 0, "tafsir_note_md": null, "tafsir_refs": null, "balagha_note_md": null, "balagha_refs": null, "gloss_json": null, "sarf_note_md": null, "sarf_refs": null, "sarf_term_ref": null, "gram_term_ref": "GT:irab_role:maful_bih"}, {"id": "QR:SSN:40:5:s2:$.tree.children[2].mudaf", "tree_id": "QR:TR:40:5:s2", "parent_node_id": "QR:SSN:40:5:s2:$.tree.children[2]", "node_label": "كُلُّ", "scope_type": null, "scope_id": null, "depth": 2, "node_order": 4, "created_at": "2026-10-08 11:50:30", "term_key": "mudaf", "label_ar": null, "note_md": null, "word_occurrence_id": "929ac0dbdb51d262878f2897ec", "is_virtual": 0, "tafsir_note_md": null, "tafsir_refs": null, "balagha_note_md": null, "balagha_refs": null, "gloss_json": null, "sarf_note_md": null, "sarf_refs": null, "sarf_term_ref": null, "gram_term_ref": "GT:irab_role:mudaf"}]
