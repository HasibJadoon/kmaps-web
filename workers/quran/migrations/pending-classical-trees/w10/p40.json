[{"id": "QR:SSN:40:4:s1:$.tree", "tree_id": "QR:TR:40:4:s1", "parent_node_id": null, "node_label": "مَا يُجَادِلُ فِي آيَاتِ اللَّهِ إِلَّا الَّذِينَ كَفَرُوا", "scope_type": null, "scope_id": null, "depth": 0, "node_order": 1, "created_at": "2026-08-28 17:54:13", "term_key": "jumlah_filiyyah", "label_ar": "جملة فعلية لا محل لها استئنافية (الجدول ودعاس نصا)؛ وهي عند ابن عاشور استئناف بياني نشأ من قوله تنزيل الكتاب من الله العزيز العليم، جوابا لسؤال مقدر: فما بال هؤلاء المجادلين لم تقنعهم دلائل نزول القرآن", "note_md": null, "word_occurrence_id": null, "is_virtual": 0, "tafsir_note_md": null, "tafsir_refs": null, "balagha_note_md": null, "balagha_refs": null, "gloss_json": null, "sarf_note_md": null, "sarf_refs": null, "sarf_term_ref": null, "gram_term_ref": "GT:sentence_class:filiyya"}, {"id": "QR:SSN:40:4:s1:$.tree.children[0]", "tree_id": "QR:TR:40:4:s1", "parent_node_id": "QR:SSN:40:4:s1:$.tree", "node_label": "مَا", "scope_type": null, "scope_id": null, "depth": 1, "node_order": 2, "created_at": "2026-08-28 17:54:13", "term_key": "harf_nafy", "label_ar": "نافية لا عمل لها (دعاس والدرويش والميسر والجدول نصا) — اتفاق رباعي", "note_md": null, "word_occurrence_id": "97a1c98333e7bbdcd89382761b", "is_virtual": 0, "tafsir_note_md": null, "tafsir_refs": null, "balagha_note_md": null, "balagha_refs": null, "gloss_json": null, "sarf_note_md": null, "sarf_refs": null, "sarf_term_ref": null, "gram_term_ref": "GT:pos:nafy_harf"}, {"id": "QR:SSN:40:4:s1:$.tree.children[1]", "tree_id": "QR:TR:40:4:s1", "parent_node_id": "QR:SSN:40:4:s1:$.tree", "node_label": "يُجَادِلُ", "scope_type": null, "scope_id": null, "depth": 1, "node_order": 3, "created_at": "2026-08-28 17:54:13", "term_key": "fiil_mudari", "label_ar": "فعل مضارع مرفوع (الميسر والدرويش نصا)، مضارع مرفوع (دعاس نصا). وصيغة المفاعلة هنا للمبالغة في الفعل من جانب واحد لإفادة التكرر، مثل سافر وعافاه الله (ابن عاشور نصا)", "note_md": null, "word_occurrence_id": "e0b646f5ca79e5eec58490d7fe", "is_virtual": 0, "tafsir_note_md": null, "tafsir_refs": null, "balagha_note_md": null, "balagha_refs": null, "gloss_json": null, "sarf_note_md": null, "sarf_refs": null, "sarf_term_ref": null, "gram_term_ref": "GT:pos:fil"}, {"id": "QR:SSN:40:4:s1:$.tree.children[2]", "tree_id": "QR:TR:40:4:s1", "parent_node_id": "QR:SSN:40:4:s1:$.tree", "node_label": "فِي آيَاتِ اللَّهِ", "scope_type": null, "scope_id": null, "depth": 1, "node_order": 4, "created_at": "2026-08-28 17:54:13", "term_key": "jar_wa_majrur", "label_ar": "جار ومجرور متعلقان بيجادل (الميسر نصا، ووافقه دعاس والجدول والدرويش). ولفظ الجدال في الشيء مشعر بالجدال الباطل، والجدال عن الشيء مشعر بتقريره والذب عنه (الرازي نصا، ونقله الآلوسي عن الإمام)", "note_md": null, "word_occurrence_id": null, "is_virtual": 0, "tafsir_note_md": null, "tafsir_refs": null, "balagha_note_md": null, "balagha_refs": null, "gloss_json": null, "sarf_note_md": null, "sarf_refs": null, "sarf_term_ref": null, "gram_term_ref": "GT:irab_role:jarr_majrur"}, {"id": "QR:SSN:40:4:s1:$.tree.children[2].children[0]", "tree_id": "QR:TR:40:4:s1", "parent_node_id": "QR:SSN:40:4:s1:$.tree.children[2]", "node_label": "آيَاتِ", "scope_type": null, "scope_id": null, "depth": 2, "node_order": 5, "created_at": "2026-08-28 17:54:13", "term_key": "majrur", "label_ar": "مجرورة بفي وهي مضاف. وجعل مجرور الحرف نفس الآيات دون تعيين نحو صدقها أو وقوعها أو صنفها، فكان جامعا للجدل بأنواعه ولمتعلق الجدل باختلاف أحواله (ابن عاشور نصا)", "note_md": null, "word_occurrence_id": null, "is_virtual": 0, "tafsir_note_md": null, "tafsir_refs": null, "balagha_note_md": null, "balagha_refs": null, "gloss_json": null, "sarf_note_md": null, "sarf_refs": null, "sarf_term_ref": null, "gram_term_ref": "GT:irab_role:jarr_majrur"}, {"id": "QR:SSN:40:4:s1:$.tree.children[2].children[0].children[0]", "tree_id": "QR:TR:40:4:s1", "parent_node_id": "QR:SSN:40:4:s1:$.tree.children[2].children[0]", "node_label": "اللَّهِ", "scope_type": null, "scope_id": null, "depth": 3, "node_order": 6, "created_at": "2026-08-28 17:54:13", "term_key": "mudaf_ilayh", "label_ar": "لفظ جلالة مضاف إليه مجرور (دعاس نصا). وإظهاره دون أن يقول في آياته لتفظيع أمرها بالصريح وللتصريح بزيادة التنويه بالقرآن (ابن عاشور نصا)؛ وفيه دلالة على أن كل آية منه يكفي كفر المجادلة فيها (الآلوسي نقلا عن الكشف)", "note_md": null, "word_occurrence_id": "53cccb0252f135e7788f8df000", "is_virtual": 0, "tafsir_note_md": null, "tafsir_refs": null, "balagha_note_md": null, "balagha_refs": null, "gloss_json": null, "sarf_note_md": null, "sarf_refs": null, "sarf_term_ref": null, "gram_term_ref": "GT:irab_role:mudaf_ilayh"}, {"id": "QR:SSN:40:4:s1:$.tree.children[3]", "tree_id": "QR:TR:40:4:s1", "parent_node_id": "QR:SSN:40:4:s1:$.tree", "node_label": "إِلَّا", "scope_type": null, "scope_id": null, "depth": 1, "node_order": 7, "created_at": "2026-08-28 17:54:13", "term_key": "hasr", "label_ar": "أداة حصر (الميسر والدرويش نصا)، حرف حصر (دعاس نصا)، للحصر (الجدول نصا) — اتفاق رباعي", "note_md": null, "word_occurrence_id": "b5c2892b4aa5496b3529f4f3e5", "is_virtual": 0, "tafsir_note_md": null, "tafsir_refs": null, "balagha_note_md": null, "balagha_refs": null, "gloss_json": null, "sarf_note_md": null, "sarf_refs": null, "sarf_term_ref": null, "gram_term_ref": "GT:harf_maani:hasr"}, {"id": "QR:SSN:40:4:s1:$.tree.children[4]", "tree_id": "QR:TR:40:4:s1", "parent_node_id": "QR:SSN:40:4:s1:$.tree", "node_label": "الَّذِينَ كَفَرُوا", "scope_type": null, "scope_id": null, "depth": 1, "node_order": 8, "created_at": "2026-08-28 17:54:13", "term_key": "fail", "label_ar": "موصول في محل رفع فاعل (الجدول نصا)، فاعل مؤخر (دعاس نصا)، فاعل (الدرويش والميسر نصا). وفي المراد به وجهان عند ابن عاشور: نفس المجادلين ويكون كفرهم إشراكهم، أو جميع الكافرين فيكون استدلالا بالأعم على الخاص", "note_md": null, "word_occurrence_id": "f7da10d7eedf472ba406aecb37", "is_virtual": 0, "tafsir_note_md": null, "tafsir_refs": null, "balagha_note_md": null, "balagha_refs": null, "gloss_json": null, "sarf_note_md": null, "sarf_refs": null, "sarf_term_ref": null, "gram_term_