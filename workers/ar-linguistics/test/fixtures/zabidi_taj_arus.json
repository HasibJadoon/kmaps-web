{"ok":true,"data":{"kind":"lisan","meta":{"slug":"zabidi_taj_arus","title_ar":"تاج العروس من جواهر القاموس","title_en":"Taj al-Arus (al-Zabidi)","author":"محمد مرتضى الحسيني الزبيدي","period":"classical","origin":"ketabonline"},"entry":{"id":"re_taj_68b1dbe97ad214a1","root_text":"اا","root_norm":"اا","page_start":122,"page_end":122,"volume_no":37,"source_url":"https://ketabonline.com/ar/books/5502","source_native_id":"[11928]"},"canonical":{"id":"b63247abc6447c4f8b23b0fd95","root_text":"اا","root_letters":"[\"ا\",\"ا\"]","root_type":"biliteral","frequency_quran":0,"meaning_core_en":null},"sections":[{"id":"sec_taj_da3bc719be520b94","seq":1,"heading_ar":"آا","page_no":122,"paragraphs":[{"kind":"prose","tokens":[{"kind":"text","value":"آا:) ( ﴿آا) : كَتَبَه بالحُمْرةِ مَعَ أَنَّ "},{"kind":"authority","name":"al-Jawhari","label":"الجوهري","authority_kind":"lexicographer"},{"kind":"text","value":"َّ ذَكَرَه فقالَ: (حَرْفٌ يُمَدُّ ويُقْصَرُ) ، فَإِذا مَدَدْتَ نَوَّنْتَ، وكَذلِكَ سائِرُ حُروفِ الهِجَاء."}]},{"kind":"prose","tokens":[{"kind":"text","value":"(و) يقالُ فِي النِّداءِ للقَريبِ: (﴾ آزَيْدُ أَي أَزَيْدُ) ."}]},{"kind":"prose","tokens":[{"kind":"text","value":"(وَالَّذِي فِي الصِّحاحِ: والألِفُ يُنادَى بهَا القَرِيبُ دُونَ البَعيدِ تقولُ: أَزَيْدُ أَقْبِل بأَلِفٍ مَقصورَة."}]},{"kind":"prose","tokens":[{"kind":"text","value":"وسَيَأْتي البَسْط فِيهِ فِي الحُروفِ اللّيِّنَةِ، وَهُنَاكَ مَوْضِعُه."}]}]}],"footnotes":[],"quran_citations":[],"hadith_quotes":[],"poetry_shawahid":[],"authorities":[{"name":"al-Jawhari","name_label":"الجوهري","kind":"lexicographer","count":1,"first_page":122}],"stats":{"paragraphs":4,"hadith":0,"poetry":0,"quran_citations":0,"footnotes":0,"authorities":1,"authority_total":1}}}