{
  "name": "knowledge-map",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "wrangler dev --config workers/backend/wrangler.toml --port 8788",
    "test": "tsx --test workers/shared/test/*.test.ts",
    "typecheck:workers": "for w in core ar-linguistics studio content worldview quran arabic backend; do npx tsc --noEmit -p workers/$w/tsconfig.json || exit 1; done",
    "deploy:pages": "npm run build -w apps/k-maps && npx wrangler pages deploy apps/k-maps/dist/k-maps/browser --project-name k-maps --branch main",
    "deploy:all": "npm run deploy:pages"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@tiptap/core": "^3.22.1",
    "@tiptap/extension-placeholder": "^3.22.1",
    "@tiptap/extension-subscript": "^3.22.3",
    "@tiptap/extension-superscript": "^3.22.3",
    "@tiptap/extension-typography": "^3.22.1",
    "@tiptap/pm": "^3.22.1",
    "@tiptap/starter-kit": "^3.22.1",
    "ts-fsrs": "^5.4.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260120.0",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^11.9.1",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3",
    "wrangler": "^4.42.2"
  }
}
